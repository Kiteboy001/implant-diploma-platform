# =============================================
# Implant Diploma Platform — Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Database (Supabase PostgreSQL)
# Get this from: https://supabase.com → Your Project → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"

# NextAuth.js v5
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# WhatsApp (Twilio) — needed in Phase 3
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# Telegram Bot — needed in Phase 3
# TELEGRAM_BOT_TOKEN=""

# Hermes Agent — needed in Phase 3
# Hermes Agent API — Railway deployment
# Change for local dev: http://127.0.0.1:8642
HERMES_API_URL="https://implant-diploma-agent-production.up.railway.app"
# HERMES_API_KEY=""
